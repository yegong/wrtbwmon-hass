#!/bin/sh

[ "${IPKG_NO_SCRIPT:-0}" = "1" ] && exit 0
[ -s "${IPKG_INSTROOT:-}/lib/functions.sh" ] || exit 0

. "${IPKG_INSTROOT:-}/lib/functions.sh"
default_postinst "$0" "$@"

if [ -z "${IPKG_INSTROOT:-}" ]; then
	/etc/init.d/rpcd reload >/dev/null 2>&1 || true
	/etc/init.d/uhttpd reload >/dev/null 2>&1 || true
fi

exit 0
